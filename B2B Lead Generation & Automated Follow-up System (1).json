        "jsCode": "for (const item of $input.all()) {\n  const rawText = item.json.text || \"\";\n  try {\n    \n    const cleanJson = rawText.replace(/```json|```/g, \"\").trim();\n    const parsedData = JSON.parse(cleanJson);\n\n    \n    item.json.score = parsedData.score;\n    item.json.rationale = parsedData.rationale;\n  } catch (e) {\n    \n    const match = rawText.match(/\"score\":\\s*(\\d+)/);\n    item.json.score = match ? parseInt(match[1]) : 0;\n  }\n}\nreturn $input.all();"
